<UserControl x:Class="Caculator.Views.MayTinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Tag = đoạn chữ chèn vào biểu thức; C / DEL / = là lệnh đặc biệt -->
        <Style x:Key="NutMay" TargetType="Button" BasedOn="{StaticResource NutCoBan}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <EventSetter Event="Click" Handler="Nut_Click"/>
        </Style>
        <Style x:Key="NutHam" TargetType="Button" BasedOn="{StaticResource NutMay}">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="NutToanTu" TargetType="Button" BasedOn="{StaticResource NutMay}">
            <Setter Property="Background" Value="#E0E7FF"/>
            <Setter Property="Foreground" Value="{StaticResource MauChinh}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NutXoa" TargetType="Button" BasedOn="{StaticResource NutMay}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="{StaticResource MauLoi}"/>
        </Style>
        <Style x:Key="NutBang" TargetType="Button" BasedOn="{StaticResource NutMay}">
            <Setter Property="Background" Value="{StaticResource MauChinh}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Tính toán thường" Style="{StaticResource TieuDe}"/>
            <TextBlock Style="{StaticResource PhuDe}"
                       Text="Bấm nút hoặc gõ trực tiếp, Enter để tính. Gõ thêm được: asin, acos, atan, exp, factorial(n), e, log(x, cơ số)."/>
        </StackPanel>

        <!-- Máy tính -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <Border Style="{StaticResource The}" Padding="14,10">
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <RadioButton x:Name="rbDo" Content="Độ (deg)" IsChecked="True" Margin="0,0,14,0" Foreground="{StaticResource MauChuPhu}"/>
                            <RadioButton Content="Radian" Foreground="{StaticResource MauChuPhu}"/>
                        </StackPanel>
                        <TextBlock x:Name="lblDangTinh" Text="Đang tính…" HorizontalAlignment="Right"
                                   Foreground="{StaticResource MauChuPhu}" Visibility="Hidden"/>
                    </DockPanel>
                    <TextBox x:Name="txtBieuThuc" FontSize="22" BorderThickness="0" Margin="0,10,0,0"
                             TextAlignment="Right" FontFamily="Cambria Math" Foreground="{StaticResource MauChu}"
                             PreviewKeyDown="TxtBieuThuc_PreviewKeyDown" PreviewTextInput="TxtBieuThuc_PreviewTextInput"/>
                    <TextBlock x:Name="lblKetQua" Text="0" FontSize="34" FontWeight="SemiBold" TextAlignment="Right"
                               Foreground="{StaticResource MauChu}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="lblLoi" FontSize="13" TextAlignment="Right" TextWrapping="Wrap"
                               Foreground="{StaticResource MauLoi}"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="5" Margin="-3,10,-3,0">
                <Button Content="sin" Tag="sin(" Style="{StaticResource NutHam}"/>
                <Button Content="cos" Tag="cos(" Style="{StaticResource NutHam}"/>
                <Button Content="tan" Tag="tan(" Style="{StaticResource NutHam}"/>
                <Button Content="ln"  Tag="ln("  Style="{StaticResource NutHam}"/>
                <Button Content="log" Tag="log(" Style="{StaticResource NutHam}"/>

                <Button Content="√"  Tag="√("  Style="{StaticResource NutHam}"/>
                <Button Content="x²" Tag="²"   Style="{StaticResource NutHam}"/>
                <Button Content="xʸ" Tag="^"   Style="{StaticResource NutHam}"/>
                <Button Content="("  Tag="("   Style="{StaticResource NutHam}"/>
                <Button Content=")"  Tag=")"   Style="{StaticResource NutHam}"/>

                <Button Content="7" Tag="7" Style="{StaticResource NutMay}"/>
                <Button Content="8" Tag="8" Style="{StaticResource NutMay}"/>
                <Button Content="9" Tag="9" Style="{StaticResource NutMay}"/>
                <Button Content="÷" Tag="÷" Style="{StaticResource NutToanTu}"/>
                <Button Content="C" Tag="C" Style="{StaticResource NutXoa}" ToolTip="Xóa hết (Esc)"/>

                <Button Content="4" Tag="4" Style="{StaticResource NutMay}"/>
                <Button Content="5" Tag="5" Style="{StaticResource NutMay}"/>
                <Button Content="6" Tag="6" Style="{StaticResource NutMay}"/>
                <Button Content="×" Tag="×" Style="{StaticResource NutToanTu}"/>
                <Button Content="⌫" Tag="DEL" Style="{StaticResource NutXoa}" ToolTip="Xóa một ký tự"/>

                <Button Content="1" Tag="1" Style="{StaticResource NutMay}"/>
                <Button Content="2" Tag="2" Style="{StaticResource NutMay}"/>
                <Button Content="3" Tag="3" Style="{StaticResource NutMay}"/>
                <Button Content="−" Tag="−" Style="{StaticResource NutToanTu}"/>
                <Button Content="π" Tag="π" Style="{StaticResource NutHam}"/>

                <Button Content="0"   Tag="0"   Style="{StaticResource NutMay}"/>
                <Button Content="."   Tag="."   Style="{StaticResource NutMay}"/>
                <Button Content="Ans" Tag="Ans" Style="{StaticResource NutHam}" ToolTip="Kết quả lần tính trước"/>
                <Button Content="+"   Tag="+"   Style="{StaticResource NutToanTu}"/>
                <Button Content="="   Tag="="   Style="{StaticResource NutBang}"/>
            </UniformGrid>
        </StackPanel>

        <!-- Lịch sử -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource The}" Margin="16,0,0,0" VerticalAlignment="Stretch">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Xóa lịch sử" DockPanel.Dock="Right" Click="BtnXoaLichSu_Click"
                            Style="{StaticResource NutCoBan}" Padding="10,4" FontSize="12"/>
                    <TextBlock Text="Lịch sử" FontWeight="SemiBold" Foreground="{StaticResource MauChu}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Bấm vào một dòng để dùng lại biểu thức." FontSize="12"
                           Foreground="{StaticResource MauChuPhu}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <ListBox x:Name="lstLichSu" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="LstLichSu_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding BieuThuc}" Foreground="{StaticResource MauChuPhu}"
                                           TextAlignment="Right" TextWrapping="Wrap" FontFamily="Cambria Math"/>
                                <TextBlock Text="{Binding KetQuaHienThi}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource MauChu}" TextAlignment="Right" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
