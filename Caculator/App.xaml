<Application x:Class="Caculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Caculator"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Bảng màu -->
        <SolidColorBrush x:Key="MauChinh" Color="#2563EB"/>
        <SolidColorBrush x:Key="MauChu" Color="#1F2A44"/>
        <SolidColorBrush x:Key="MauChuPhu" Color="#6B7280"/>
        <SolidColorBrush x:Key="MauNen" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="MauVien" Color="#E3E7EF"/>
        <SolidColorBrush x:Key="MauLoi" Color="#B91C1C"/>

        <!-- Khung trắng bo góc -->
        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TieuDe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MauChu}"/>
        </Style>
        <Style x:Key="PhuDe" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}"/>
            <Setter Property="Margin" Value="0,2,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Nút cơ bản: bo góc, tối nhẹ khi rê chuột / bấm -->
        <Style x:Key="NutCoBan" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource MauChu}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="goc">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <Border x:Name="phu" Background="Black" Opacity="0" CornerRadius="6"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="phu" Property="Opacity" Value="0.06"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="phu" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="goc" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NutChinh" TargetType="Button" BasedOn="{StaticResource NutCoBan}">
            <Setter Property="Background" Value="{StaticResource MauChinh}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,8"/>
        </Style>

        <!-- Một mục trong menu bên trái -->
        <Style x:Key="MucMenu" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Menu"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="nen" Background="Transparent" CornerRadius="6" Padding="12,11" Margin="0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="nen" Property="Background" Value="#273449"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="nen" Property="Background" Value="{StaticResource MauChinh}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BieuTuongMenu" TargetType="TextBlock">
            <Setter Property="Width" Value="36"/>
            <Setter Property="FontFamily" Value="Cambria Math"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Application.Resources>
</Application>
